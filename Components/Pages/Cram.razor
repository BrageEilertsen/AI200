@page "/cram"
@rendermode InteractiveServer
@implements IDisposable
@inject ExamContext Exams
@inject IJSRuntime Js

<PageTitle>Cram sheet — @Exams.Exam.Code Trainer</PageTitle>

<div class="page-head">
    <div class="eyebrow">@Exams.Exam.Code cram sheet</div>
    <h1>Highest yield per minute</h1>
    <p class="lede">
        Defaults, limits and distinctions the exam leans on. Read this the morning of, then sit
        one mock. Everything here maps to a bullet in the published skills outline.
    </p>
    @if (HasSheet)
    {
        <div class="row no-print" style="margin-top:18px">
            <button class="btn tinted" @onclick="Print">Print or save as PDF</button>
            <span class="xs faint">Prints without the app chrome, in a light palette, with doc links spelled out</span>
        </div>
    }
</div>

@if (!HasSheet)
{
    <div class="empty">
        No cram sheet has been written for @Exams.Exam.Code yet.<br />
        <span class="xs">Add <span class="mono">Data/@(Exams.Exam.Slug)/cram.md</span> and it appears here.</span>
    </div>
}
else
{
    @* The href must carry the page path: with <base href="/"> a bare "#anchor" resolves
       against the base URL and lands on the dashboard. data-enhance-nav="false" then stops
       Blazor intercepting the click and rewriting the URL without ever scrolling. *@
    <div class="card section no-print">
        <div class="toc" data-enhance-nav="false">
            @foreach (var (section, index) in _sections.Select((s, i) => (s, i)))
            {
                if (index > 0)
                {
                    <span class="sep">/</span>
                }
                <a href="cram#@section.Anchor">@section.Title</a>
            }
        </div>
    </div>

    @_rendered
}

@code {
    private MarkupString _rendered;
    private IReadOnlyList<CramSection> _sections = [];

    private bool HasSheet => !string.IsNullOrWhiteSpace(Exams.Bank.CramSheet);

    protected override void OnInitialized()
    {
        Exams.Changed += OnExamChanged;
        Build();
    }

    public void Dispose() => Exams.Changed -= OnExamChanged;

    private void OnExamChanged()
    {
        Build();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await Exams.EnsureLoadedAsync())
        {
            Build();
            StateHasChanged();
        }
    }

    private void Build()
    {
        _sections = CramSheet.Sections(Exams.Bank.CramSheet);
        _rendered = CramSheet.Render(Exams.Bank.CramSheet);
    }

    private async Task Print() => await Js.InvokeVoidAsync("window.print");
}
