@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject ExamContext Exams
@inject ExamCatalog Catalog
@inject ProgressStore Progress
@inject NavigationManager Nav

<PageTitle>@Exams.Exam.Code Trainer</PageTitle>

<div class="page-head">
    <div class="eyebrow">@Exams.Exam.Code · @Exams.Exam.Certification</div>
    <h1>@Exams.Exam.Title</h1>
    <p class="lede">
        @Exams.Exam.QuestionRangeLabel in @Exams.Exam.DurationLabel. @Exams.Exam.PassMark of 1000 to pass.
        The @Exams.Exam.Domains.Count skill areas below are the published outline — every question
        in this bank is tagged to one of them.
    </p>
</div>

@if (Exams.Bank.Problems.Count > 0)
{
    <div class="banner bad">
        <b>@Exams.Bank.Problems.Count problem(s) in the question bank</b>
        <ul style="margin:8px 0 0;padding-left:20px">
            @foreach (var problem in Exams.Bank.Problems.Take(12))
            {
                <li class="mono xs">@problem</li>
            }
        </ul>
    </div>
}

@if (Exams.Bank.Questions.Count == 0)
{
    <div class="banner warn">
        No questions loaded for @Exams.Exam.Code. Check that
        <span class="mono">@System.IO.Path.Combine(Catalog.DataDirectory, Exams.Exam.Slug)</span>
        contains the JSON files, then reload.
    </div>
}

<div class="grid cols-4 section">
    <div class="stat-card">
        <div class="stat-body">
            <div class="stat-label">Question bank</div>
            <div class="stat-value">@Exams.Bank.Questions.Count</div>
            <div class="stat-note">across @Exams.Exam.Domains.Count areas</div>
        </div>
    </div>

    <div class="stat-card">
        <Ring Percent="_coveragePercent" Colour="var(--accent)" />
        <div class="stat-body">
            <div class="stat-label">Covered</div>
            <div class="stat-value">@($"{_coveragePercent:F0}")<span class="unit">%</span></div>
            <div class="stat-note">@_unseen not yet seen</div>
        </div>
    </div>

    <div class="stat-card">
        <Ring Percent="_lifetimeAccuracy" Colour="@Grade(_lifetimeAccuracy, _attempts)" />
        <div class="stat-body">
            <div class="stat-label">Accuracy</div>
            <div class="stat-value" style="color:@Grade(_lifetimeAccuracy, _attempts)">
                @if (_attempts == 0)
                {
                    <text>—</text>
                }
                else
                {
                    @($"{_lifetimeAccuracy:F0}")<span class="unit">%</span>
                }
            </div>
            <div class="stat-note">@_attempts answers recorded</div>
        </div>
    </div>

    <div class="stat-card">
        @if (_lastExam is { } exam)
        {
            <Ring Percent="exam.ScaledScore / 10.0" Colour="@(exam.ScaledScore >= Exams.Exam.PassMark ? "var(--good)" : "var(--bad)")" />
        }
        <div class="stat-body">
            <div class="stat-label">Last mock</div>
            @if (_lastExam is { } last)
            {
                <div class="stat-value" style="color:@(last.ScaledScore >= Exams.Exam.PassMark ? "var(--good)" : "var(--bad)")">
                    @last.ScaledScore
                </div>
                <div class="stat-note">@last.FinishedAt.ToString("d MMM, HH:mm")</div>
            }
            else
            {
                <div class="stat-value faint">—</div>
                <div class="stat-note">not sat yet</div>
            }
        </div>
    </div>
</div>

<div class="section">
    <div class="row between" style="margin-bottom:16px">
        <h2>Skills measured</h2>
        <span class="xs faint">Weight = share of the live exam</span>
    </div>

    <div class="card flush">
        <div class="inset-list">
            @foreach (var domain in Exams.Exam.Domains)
            {
                var stats = DomainStats(domain.Key);
                <div class="inset-row">
                    <div class="row between" style="margin-bottom:11px">
                        <span class="domain-name">
                            <span class="swatch" style="background-color:@domain.Accent"></span>
                            @domain.Name
                            <span class="domain-weight">@domain.WeightLabel</span>
                        </span>
                        <span class="xs nowrap num">
                            <span class="faint">@Exams.Bank.CountFor(domain.Key) questions</span>
                            @if (stats.Attempts > 0)
                            {
                                <span class="q-sep"> · </span>
                                <span style="color:@Grade(stats.Accuracy, stats.Attempts)">@($"{stats.Accuracy:F0}% correct")</span>
                            }
                        </span>
                    </div>
                    <div class="bar">
                        <span style="width:@Css.Pct(stats.Accuracy);background-color:@domain.Accent"></span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="section">
    <h2>Start studying</h2>
    <div class="grid cols-3">
        <div class="card">
            <h3>Practice set</h3>
            <p class="small muted" style="margin-top:8px">
                Answer, check, read the explanation, move on. Choose your areas and weight the
                draw toward what you keep getting wrong.
            </p>
            <button class="btn primary" @onclick='() => Nav.NavigateTo("practice")'>Configure practice</button>
        </div>
        <div class="card">
            <h3>Exam simulation</h3>
            <p class="small muted" style="margin-top:8px">
                @Exams.Exam.DefaultMockSize questions in the real weightings,
                @Exams.Exam.DefaultMockMinutes minutes on the clock, nothing graded until you
                submit. The closest thing to sitting it.
            </p>
            <button class="btn primary" @onclick='() => Nav.NavigateTo("exam")'>Set up a mock</button>
        </div>
        <div class="card">
            <h3>Cram sheet</h3>
            <p class="small muted" style="margin-top:8px">
                Defaults, limits and the distinctions the exam leans on — the highest yield per
                minute of reading on the last day.
            </p>
            <button class="btn tinted" @onclick='() => Nav.NavigateTo("cram")'>Open cram sheet</button>
        </div>
    </div>
</div>

<div class="row xs faint">
    <span>
        Loaded @Catalog.LoadedAt.ToString("HH:mm:ss")
        @if (Exams.Exam.StudyGuideUrl is { Length: > 0 } guide)
        {
            <text> · </text>
            <a href="@guide" target="_blank" rel="noopener">published skills outline ↗</a>
        }
    </span>
    <span class="spacer"></span>
    <button class="btn ghost sm" @onclick="Reload">Reload bank</button>
</div>

@code {
    private int _unseen;
    private int _attempts;
    private int _correct;
    private double _lifetimeAccuracy;
    private double _coveragePercent;
    private SessionRecord? _lastExam;

    protected override void OnInitialized()
    {
        Exams.Changed += OnExamChanged;
        Recalculate();
    }

    public void Dispose() => Exams.Changed -= OnExamChanged;

    private void OnExamChanged()
    {
        Recalculate();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Both the chosen exam and the progress for it live in the browser, so neither is
        // known until the circuit is up. The page renders with the default exam and empty
        // figures, then fills in.
        var switched = await Exams.EnsureLoadedAsync();
        var loaded = await Progress.EnsureLoadedAsync();

        if (switched || loaded)
        {
            Recalculate();
            StateHasChanged();
        }
    }

    private void Recalculate()
    {
        var coverage = Progress.Coverage(Exams.Bank.Questions);
        _unseen = coverage.Unseen;
        _attempts = coverage.Seen;
        _correct = coverage.Correct;
        _lifetimeAccuracy = _attempts == 0 ? 0 : 100.0 * _correct / _attempts;
        _coveragePercent = Exams.Bank.Questions.Count == 0
            ? 0
            : 100.0 * (Exams.Bank.Questions.Count - _unseen) / Exams.Bank.Questions.Count;
        _lastExam = Progress.Sessions.LastOrDefault(s => s.Mode == SessionMode.Exam);
    }

    private (int Attempts, double Accuracy) DomainStats(string domainKey)
    {
        var coverage = Progress.Coverage(Exams.Bank.Questions.Where(q => q.Domain == domainKey));
        return (coverage.Seen, coverage.Seen == 0 ? 0 : 100.0 * coverage.Correct / coverage.Seen);
    }

    private static string Grade(double percent, int attempts) => attempts == 0
        ? "var(--text-3)"
        : percent switch
        {
            >= 80 => "var(--good)",
            >= 65 => "var(--warn)",
            _ => "var(--bad)"
        };

    private void Reload()
    {
        Catalog.Load();
        Recalculate();
    }
}
