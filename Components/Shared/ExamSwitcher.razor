@rendermode InteractiveServer
@implements IDisposable
@inject ExamContext Exams

@*
    A hand-built listbox rather than a <select>. The native popup is drawn by the operating
    system and ignores CSS entirely, so on click it dropped out of the app's type and shape
    into plain system rectangles. This keeps the menu inside the page where it can be styled.
*@
@if (Exams.HasMultipleExams)
{
    // @ref compiles to an assignment, so it cannot take a conditional expression — every
    // option captures into its own slot and the active index is read back when focusing.
    _optionRefs = _optionRefs.Length == Exams.All.Count ? _optionRefs : new ElementReference[Exams.All.Count];

    <div class="exam-switch @(_open ? "open" : "")">
        <div class="exam-switch-label" id="exam-switch-label">Studying</div>

        <button type="button"
                class="exam-trigger"
                @ref="_triggerRef"
                @onclick="Toggle"
                @onkeydown="OnTriggerKey"
                aria-haspopup="listbox"
                aria-expanded="@_open.ToString().ToLowerInvariant()"
                aria-labelledby="exam-switch-label exam-switch-value">
            <span class="exam-trigger-text" id="exam-switch-value">
                <span class="exam-trigger-code">@Exams.Exam.Code</span>
                <span class="exam-trigger-cert">@Exams.Exam.Certification</span>
            </span>
            <svg class="exam-chevron" viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        @if (_open)
        {
            @* Most of the page is not focusable, so a click on plain background moves focus
               nowhere. This catches those clicks. It sits under the menu, not over it. *@
            <div class="exam-backdrop" @onclick="CloseAndReturnFocus"></div>

            <div class="exam-menu" role="listbox" aria-labelledby="exam-switch-label">
                @foreach (var (bank, i) in Exams.All.Select((b, i) => (b, i)))
                {
                    var slug = bank.Definition.Slug;
                    var index = i;
                    var current = slug == Exams.Exam.Slug;

                    <button type="button"
                            role="option"
                            aria-selected="@current.ToString().ToLowerInvariant()"
                            class="exam-option @(current ? "on" : "") @(i == _active ? "active" : "")"
                            @ref="_optionRefs[index]"
                            @onclick="() => Choose(slug)"
                            @onkeydown="OnMenuKey"
                            @onmouseenter="() => _active = index">
                        <span class="exam-option-text">
                            <span class="exam-option-code">@bank.Definition.Code</span>
                            <span class="exam-option-cert">@bank.Definition.Certification</span>
                        </span>
                        @if (current)
                        {
                            <svg class="exam-check" viewBox="0 0 12 10" aria-hidden="true">
                                <path d="M1 5l3.4 3.4L11 1.6" fill="none" stroke="currentColor"
                                      stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private bool _open;
    private int _active;
    private ElementReference _triggerRef;
    private ElementReference[] _optionRefs = [];

    // Which element should hold focus after the next render. Focus has to be moved after the
    // DOM exists, so it is requested here and applied in OnAfterRenderAsync.
    private enum FocusTarget { None, ActiveOption, Trigger }
    private FocusTarget _pendingFocus = FocusTarget.None;

    protected override void OnInitialized() => Exams.Changed += Refresh;

    public void Dispose() => Exams.Changed -= Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The remembered exam lives in the browser, so the first render shows the default.
        if (firstRender && await Exams.EnsureLoadedAsync())
        {
            StateHasChanged();
            return;
        }

        var target = _pendingFocus;
        _pendingFocus = FocusTarget.None;

        try
        {
            switch (target)
            {
                case FocusTarget.ActiveOption when _open && _active < _optionRefs.Length:
                    await _optionRefs[_active].FocusAsync();
                    break;
                case FocusTarget.Trigger:
                    await _triggerRef.FocusAsync();
                    break;
            }
        }
        catch
        {
            // The element went away between the render and the focus call; nothing to do.
        }
    }

    private void Open()
    {
        _open = true;
        _active = IndexOfCurrent();

        // Focus moves into the menu so the arrow keys have somewhere to act. Without this the
        // menu is reachable by mouse only.
        _pendingFocus = FocusTarget.ActiveOption;
    }

    private void Toggle()
    {
        if (_open) CloseAndReturnFocus();
        else Open();
    }

    private void CloseAndReturnFocus()
    {
        _open = false;
        _pendingFocus = FocusTarget.Trigger;
    }

    private int IndexOfCurrent()
    {
        for (var i = 0; i < Exams.All.Count; i++)
        {
            if (Exams.All[i].Definition.Slug == Exams.Exam.Slug) return i;
        }
        return 0;
    }

    private async Task Choose(string slug)
    {
        _open = false;
        _pendingFocus = FocusTarget.Trigger;
        await Exams.SelectAsync(slug);
    }

    private void OnTriggerKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            // Enter and Space already reach Toggle through the button's native click, so
            // handling them here as well would open and immediately close again.
            case "ArrowDown" or "ArrowUp" when !_open:
                Open();
                break;
            case "Escape" when _open:
                CloseAndReturnFocus();
                break;
        }
    }

    private async Task OnMenuKey(KeyboardEventArgs e)
    {
        var count = Exams.All.Count;

        switch (e.Key)
        {
            case "ArrowDown":
                _active = (_active + 1) % count;
                _pendingFocus = FocusTarget.ActiveOption;
                break;
            case "ArrowUp":
                _active = (_active - 1 + count) % count;
                _pendingFocus = FocusTarget.ActiveOption;
                break;
            case "Home":
                _active = 0;
                _pendingFocus = FocusTarget.ActiveOption;
                break;
            case "End":
                _active = count - 1;
                _pendingFocus = FocusTarget.ActiveOption;
                break;
            case "Escape" or "Tab":
                CloseAndReturnFocus();
                break;
            // Enter and Space activate the focused option natively, which runs Choose.
        }
    }
}
