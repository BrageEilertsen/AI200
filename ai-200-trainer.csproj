<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ai200Trainer</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!-- This machine blocks launching executables from the user profile (Windows 11 Enterprise
         policy), so `dotnet run` fails with "Ingen tilgang" on the generated apphost .exe.
         Suppressing the apphost makes `dotnet run` execute the DLL through the already-trusted
         dotnet host instead. Remove this if the app ever needs to ship as a standalone .exe. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Question bank is read from the content root at runtime so you can edit
         the JSON and just refresh the page (Reload bank on the Home screen). -->
    <Content Update="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cram sheets ship alongside each exam's questions. The Web SDK treats .md as None
         by default, so these need including rather than updating. -->
    <Content Include="Data\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Data\**\*.md" />
  </ItemGroup>

</Project>
